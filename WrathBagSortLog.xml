<Ui xmlns="http://www.runewaker.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.runewaker.com/UI.xsd">

    <EditBox name="WrathBagSortLogEditBoxTemplate" inherits="UIPanelEditBoxTemplate" virtual="true">
        <Size>
            <AbsDimension x="660" y="20" />
        </Size>
    </EditBox>

    <Frame name="WrathBagSortLogFrame" parent="UIParent" hidden="true" enableMouse="true">
        <Size>
            <AbsDimension x="700" y="760"/>
        </Size>
        <Anchors>
            <Anchor point="TOPLEFT">
                <Offset>
                    <AbsDimension x="10" y="10"/>
                </Offset>
            </Anchor>
        </Anchors>

        <Backdrop edgeFile="Interface\Tooltips\Tooltip-border" bgFile="Interface\Tooltips\Tooltip-Background">
            <BackgroundInsets>
                <AbsInset top="4" left="4" bottom="4" right="4"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="16"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="16"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <Layer>
                <FontString name="$parentLabel" inherits="GameTitleFont" justifyH="LEFT" text="WrathBagSort Log - top box = all lines (Ctrl+A, Ctrl+C to copy)">
                    <FontHeight>
                        <AbsValue val="14" />
                    </FontHeight>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
                            <Offset>
                                <AbsDimension x="10" y="10"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButtonTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-8" y="8"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <Slider name="WrathBagSortLogScrollBar" inherits="UIPanelScrollBarHaveBackdropTemplate">
                <Size>
                    <AbsDimension x="20" y="690"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-8" y="40"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:SetValueStepMode("INT")
                    </OnLoad>
                    <OnValueChanged>
                        UIPanelScrollBar_OnValueChanged(this, arg1)
                        WrathBagSort.LogUpdate()
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <EditBox name="WrathBagSortLogCopyAll" inherits="WrathBagSortLogEditBoxTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="10" y="38" />
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        if this.HighlightText then this:HighlightText() end
                    </OnClick>
                </Scripts>
            </EditBox>
            <EditBox name="WrathBagSortLogMessage1" inherits="WrathBagSortLogEditBoxTemplate" id="1">
